diff --git a/agent/agent_watchdog.go b/agent/agent_watchdog.go
new file mode 100644
index 00000000..ae2d90c2
--- /dev/null
+++ b/agent/agent_watchdog.go
@@ -0,0 +1,147 @@
+package agent
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/buildkite/agent/v3/logger"
+)
+
+type workerWatchdogState uint8
+
+const (
+	workerWatchdogConnecting workerWatchdogState = iota
+	workerWatchdogRunning
+	workerWatchdogStopped
+	workerWatchdogFailed
+)
+
+type workerWatchdog struct {
+	state                 workerWatchdogState
+	lastSuccessfulContact time.Time
+	err                   error
+}
+
+type watchdogNotifier interface {
+	Ready() error
+	Stopping() error
+	Watchdog() error
+	WatchdogInterval() time.Duration
+}
+
+func (a *AgentWorker) watchdogMarkConnecting() {
+	a.watchdogMtx.Lock()
+	defer a.watchdogMtx.Unlock()
+
+	a.watchdog.state = workerWatchdogConnecting
+	a.watchdog.lastSuccessfulContact = time.Now()
+	a.watchdog.err = nil
+}
+
+func (a *AgentWorker) watchdogMarkRunning() {
+	a.watchdogMtx.Lock()
+	defer a.watchdogMtx.Unlock()
+
+	a.watchdog.state = workerWatchdogRunning
+	// Connect succeeded immediately before the worker started, so begin the
+	// heartbeat grace period from that successful Buildkite API contact.
+	a.watchdog.lastSuccessfulContact = time.Now()
+	a.watchdog.err = nil
+}
+
+func (a *AgentWorker) watchdogMarkStopped() {
+	a.watchdogMtx.Lock()
+	defer a.watchdogMtx.Unlock()
+
+	a.watchdog.state = workerWatchdogStopped
+	a.watchdog.err = nil
+}
+
+func (a *AgentWorker) watchdogMarkFailed(err error) {
+	a.watchdogMtx.Lock()
+	defer a.watchdogMtx.Unlock()
+
+	a.watchdog.state = workerWatchdogFailed
+	a.watchdog.err = err
+}
+
+func (a *AgentWorker) watchdogRecordSuccessfulHeartbeat() {
+	a.watchdogMtx.Lock()
+	defer a.watchdogMtx.Unlock()
+
+	if a.watchdog.state == workerWatchdogRunning {
+		a.watchdog.lastSuccessfulContact = time.Now()
+	}
+}
+
+func (a *AgentWorker) watchdogHealth(now time.Time, maxContactAge time.Duration) error {
+	a.watchdogMtx.Lock()
+	defer a.watchdogMtx.Unlock()
+
+	switch a.watchdog.state {
+	case workerWatchdogConnecting, workerWatchdogStopped:
+		// Connecting is bounded by the client's retry policy, while an
+		// intentionally stopped worker no longer contributes to pool health.
+		return nil
+	case workerWatchdogFailed:
+		if a.watchdog.err == nil {
+			return fmt.Errorf("worker %d failed", a.spawnIndex)
+		}
+		return fmt.Errorf("worker %d failed: %w", a.spawnIndex, a.watchdog.err)
+	case workerWatchdogRunning:
+		if a.watchdog.lastSuccessfulContact.IsZero() {
+			return fmt.Errorf("worker %d has not successfully contacted Buildkite", a.spawnIndex)
+		}
+		age := now.Sub(a.watchdog.lastSuccessfulContact)
+		if age > maxContactAge {
+			return fmt.Errorf("worker %d has not successfully contacted Buildkite for %s", a.spawnIndex, age.Round(time.Second))
+		}
+		return nil
+	default:
+		return fmt.Errorf("worker %d has unknown watchdog state %d", a.spawnIndex, a.watchdog.state)
+	}
+}
+
+func (ap *AgentPool) runWatchdog(ctx context.Context, l logger.Logger, watchdogInterval time.Duration) {
+	// systemd recommends notifying every half of the configured interval.
+	ticker := time.NewTicker(watchdogInterval / 2)
+	defer ticker.Stop()
+
+	ap.runWatchdogLoop(ctx, l, watchdogInterval, ticker.C)
+}
+
+func (ap *AgentPool) runWatchdogLoop(ctx context.Context, l logger.Logger, watchdogInterval time.Duration, ticks <-chan time.Time) {
+	for {
+		select {
+		case now, ok := <-ticks:
+			if !ok {
+				return
+			}
+			ap.notifyWatchdog(l, watchdogInterval, now)
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+func (ap *AgentPool) notifyWatchdog(l logger.Logger, watchdogInterval time.Duration, now time.Time) {
+	if err := ap.watchdogHealth(now, watchdogInterval/2); err != nil {
+		l.Warnf("Buildkite heartbeat has not succeeded; not sending systemd watchdog notification: %v", err)
+		return
+	}
+	if err := ap.watchdog.Watchdog(); err != nil {
+		l.Warnf("Failed to notify systemd watchdog: %v", err)
+		return
+	}
+	l.Debugf("Notified systemd watchdog")
+}
+
+func (ap *AgentPool) watchdogHealth(now time.Time, maxContactAge time.Duration) error {
+	for _, worker := range ap.workers {
+		if err := worker.watchdogHealth(now, maxContactAge); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/agent/agent_watchdog_test.go b/agent/agent_watchdog_test.go
new file mode 100644
index 00000000..9f6e2e4e
--- /dev/null
+++ b/agent/agent_watchdog_test.go
@@ -0,0 +1,310 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/buildkite/agent/v3/api"
+	"github.com/buildkite/agent/v3/logger"
+)
+
+type fakeWatchdogNotifier struct {
+	interval time.Duration
+
+	mu       sync.Mutex
+	ready    int
+	stopping int
+	watchdog int
+	watchErr error
+}
+
+func (n *fakeWatchdogNotifier) Ready() error {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.ready++
+	return nil
+}
+
+func (n *fakeWatchdogNotifier) Stopping() error {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.stopping++
+	return nil
+}
+
+func (n *fakeWatchdogNotifier) Watchdog() error {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.watchdog++
+	return n.watchErr
+}
+
+func (n *fakeWatchdogNotifier) WatchdogInterval() time.Duration {
+	return n.interval
+}
+
+func (n *fakeWatchdogNotifier) watchdogCount() int {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	return n.watchdog
+}
+
+func (n *fakeWatchdogNotifier) lifecycleCounts() (ready, stopping int) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	return n.ready, n.stopping
+}
+
+func TestAgentWorkerWatchdogHealth(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	failure := errors.New("heartbeat rejected")
+	tests := []struct {
+		name      string
+		watchdog  workerWatchdog
+		wantError string
+	}{
+		{
+			name:     "connecting worker",
+			watchdog: workerWatchdog{state: workerWatchdogConnecting},
+		},
+		{
+			name: "running worker with recent Buildkite contact",
+			watchdog: workerWatchdog{
+				state:                 workerWatchdogRunning,
+				lastSuccessfulContact: now.Add(-time.Minute),
+			},
+		},
+		{
+			name: "running worker with stale Buildkite contact",
+			watchdog: workerWatchdog{
+				state:                 workerWatchdogRunning,
+				lastSuccessfulContact: now.Add(-2 * time.Minute),
+			},
+			wantError: "has not successfully contacted Buildkite",
+		},
+		{
+			name:      "failed worker",
+			watchdog:  workerWatchdog{state: workerWatchdogFailed, err: failure},
+			wantError: failure.Error(),
+		},
+		{
+			name:     "intentionally stopped worker",
+			watchdog: workerWatchdog{state: workerWatchdogStopped},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+
+			worker := &AgentWorker{
+				spawnIndex: 3,
+				watchdog:   test.watchdog,
+			}
+			err := worker.watchdogHealth(now, 90*time.Second)
+			if test.wantError == "" {
+				if err != nil {
+					t.Errorf("watchdogHealth() error = %v, want nil", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), test.wantError) {
+				t.Errorf("watchdogHealth() error = %v, want error containing %q", err, test.wantError)
+			}
+		})
+	}
+}
+
+func TestAgentWorkerSuccessfulHeartbeatDoesNotReviveFailedWorker(t *testing.T) {
+	t.Parallel()
+
+	worker := &AgentWorker{}
+	worker.watchdogMarkFailed(errors.New("failed"))
+	worker.watchdogRecordSuccessfulHeartbeat()
+
+	if err := worker.watchdogHealth(time.Now(), time.Minute); err == nil {
+		t.Fatal("watchdogHealth() error = nil, want failed worker error")
+	}
+}
+
+func TestAgentWorkerHeartbeatRecordsOnlySuccessfulBuildkiteContact(t *testing.T) {
+	t.Parallel()
+
+	var rejectHeartbeat atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if rejectHeartbeat.Load() {
+			http.Error(w, "heartbeat rejected", http.StatusUnauthorized)
+			return
+		}
+
+		var heartbeat api.Heartbeat
+		if err := json.NewDecoder(r.Body).Decode(&heartbeat); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		heartbeat.ReceivedAt = time.Now().Format(time.RFC3339Nano)
+		if err := json.NewEncoder(w).Encode(heartbeat); err != nil {
+			t.Errorf("Encode(heartbeat) error = %v", err)
+		}
+	}))
+	t.Cleanup(server.Close)
+
+	worker := &AgentWorker{
+		apiClient: api.NewClient(logger.Discard, api.Config{
+			Endpoint: server.URL,
+			Token:    "test-token",
+		}),
+		logger: logger.Discard,
+		watchdog: workerWatchdog{
+			state:                 workerWatchdogRunning,
+			lastSuccessfulContact: time.Now().Add(-time.Minute),
+		},
+	}
+	lastSuccessfulContact := func() time.Time {
+		worker.watchdogMtx.Lock()
+		defer worker.watchdogMtx.Unlock()
+		return worker.watchdog.lastSuccessfulContact
+	}
+
+	beforeSuccess := lastSuccessfulContact()
+	if err := worker.Heartbeat(t.Context()); err != nil {
+		t.Fatalf("Heartbeat() error = %v, want nil", err)
+	}
+	afterSuccess := lastSuccessfulContact()
+	if !afterSuccess.After(beforeSuccess) {
+		t.Errorf("lastSuccessfulContact after successful heartbeat = %s, want after %s", afterSuccess, beforeSuccess)
+	}
+
+	rejectHeartbeat.Store(true)
+	if err := worker.Heartbeat(t.Context()); err == nil {
+		t.Fatal("Heartbeat() error = nil, want heartbeat rejection")
+	}
+	if got := lastSuccessfulContact(); got != afterSuccess {
+		t.Errorf("lastSuccessfulContact after rejected heartbeat = %s, want unchanged %s", got, afterSuccess)
+	}
+}
+
+func TestAgentPoolWatchdogNotifiesForHealthyWorkers(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	worker := &AgentWorker{
+		watchdog: workerWatchdog{
+			state:                 workerWatchdogRunning,
+			lastSuccessfulContact: now,
+		},
+	}
+	notifier := &fakeWatchdogNotifier{}
+	pool := &AgentPool{
+		workers:  []*AgentWorker{worker},
+		watchdog: notifier,
+	}
+
+	pool.notifyWatchdog(logger.Discard, 2*time.Minute, now.Add(time.Minute))
+	if got := notifier.watchdogCount(); got != 1 {
+		t.Errorf("Watchdog() calls = %d, want 1", got)
+	}
+}
+
+func TestAgentPoolWatchdogSkipsUnhealthyWorkers(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	notifier := &fakeWatchdogNotifier{}
+	pool := &AgentPool{
+		workers: []*AgentWorker{{
+			watchdog: workerWatchdog{
+				state:                 workerWatchdogRunning,
+				lastSuccessfulContact: now.Add(-2 * time.Minute),
+			},
+		}},
+		watchdog: notifier,
+	}
+	pool.notifyWatchdog(logger.Discard, 2*time.Minute, now)
+	if got := notifier.watchdogCount(); got != 0 {
+		t.Errorf("Watchdog() calls = %d, want 0", got)
+	}
+}
+
+func TestAgentPoolWatchdogContinuesAfterNotificationError(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now()
+	notifier := &fakeWatchdogNotifier{
+		watchErr: errors.New("send failed"),
+	}
+	pool := &AgentPool{
+		workers: []*AgentWorker{{
+			watchdog: workerWatchdog{
+				state:                 workerWatchdogRunning,
+				lastSuccessfulContact: now,
+			},
+		}},
+		watchdog: notifier,
+	}
+
+	pool.notifyWatchdog(logger.Discard, 2*time.Minute, now)
+	pool.notifyWatchdog(logger.Discard, 2*time.Minute, now)
+	if got := notifier.watchdogCount(); got != 2 {
+		t.Errorf("Watchdog() calls = %d, want 2", got)
+	}
+}
+
+func TestAgentPoolWatchdogLoopStops(t *testing.T) {
+	t.Parallel()
+
+	pool := &AgentPool{}
+	ticks := make(chan time.Time)
+	ctx, cancel := context.WithCancel(t.Context())
+	done := make(chan struct{})
+	go func() {
+		pool.runWatchdogLoop(ctx, logger.Discard, 2*time.Minute, ticks)
+		close(done)
+	}()
+
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("watchdog loop did not stop after context cancellation")
+	}
+}
+
+func TestAgentPoolNotifiesSystemdLifecycle(t *testing.T) {
+	t.Parallel()
+
+	notifier := &fakeWatchdogNotifier{}
+	pool := &AgentPool{watchdog: notifier}
+	if err := pool.Start(t.Context()); err != nil {
+		t.Fatalf("Start() error = %v, want nil", err)
+	}
+
+	ready, stopping := notifier.lifecycleCounts()
+	if ready != 1 {
+		t.Errorf("Ready() calls = %d, want 1", ready)
+	}
+	if stopping != 1 {
+		t.Errorf("Stopping() calls = %d, want 1", stopping)
+	}
+}
+
+func TestAgentPoolRejectsInvalidSystemdWatchdogConfiguration(t *testing.T) {
+	t.Parallel()
+
+	want := errors.New("invalid watchdog configuration")
+	pool := &AgentPool{watchdogErr: want}
+	err := pool.Start(t.Context())
+	if !errors.Is(err, want) {
+		t.Fatalf("Start() error = %v, want error wrapping %v", err, want)
+	}
+}
