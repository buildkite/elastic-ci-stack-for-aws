#!/bin/bash
set -eu -o pipefail

echo "~~~ :earth_asia: Setting up environment variables"
# shellcheck source=/dev/null
source /c/buildkite-agent/cfn-env

# a clean docker config for each job, for improved isolation
BUILDKITE_DOCKER_CONFIG_TEMP_DIRECTORY=$(mktemp -d)
export BUILDKITE_DOCKER_CONFIG_TEMP_DIRECTORY
export DOCKER_CONFIG="$BUILDKITE_DOCKER_CONFIG_TEMP_DIRECTORY"

if [ "${BUILDKITE_DOCKER_EXPERIMENTAL:-false}" = "true" ]; then
  #shellcheck disable=SC2094 # Redirections to the same command are processed in order
  cat <<<"$(jq '.experimental="enabled"' "${DOCKER_CONFIG}/config.json")" >"${DOCKER_CONFIG}/config.json"
fi

echo "~~~ :llama: Setting up elastic stack environment ($BUILDKITE_STACK_VERSION)"

echo "Configuring built-in plugins"

# Pad with spaces so each substitution only removes a whole plugin name
# ("ecr" is also a substring of "secrets")
PLUGINS_ENABLED=" ${PLUGINS_ENABLED} "
[[ ! ${SECRETS_PLUGIN_ENABLED:-true} =~ (on|1|true) ]] && PLUGINS_ENABLED=${PLUGINS_ENABLED/ secrets / }
[[ ! ${DOCKER_LOGIN_PLUGIN_ENABLED:-true} =~ (on|1|true) ]] && PLUGINS_ENABLED=${PLUGINS_ENABLED/ docker-login / }
[[ ! ${ECR_PLUGIN_ENABLED:-true} =~ (on|1|true) ]] && PLUGINS_ENABLED=${PLUGINS_ENABLED/ ecr / }

SECRETS_PLUGIN_ENABLED=0
DOCKER_LOGIN_PLUGIN_ENABLED=0
ECR_PLUGIN_ENABLED=0

for plugin in $PLUGINS_ENABLED; do
  case "$plugin" in
  secrets)
    export SECRETS_PLUGIN_ENABLED=1
    echo "Secrets plugin enabled"
    ;;
  docker-login)
    export DOCKER_LOGIN_PLUGIN_ENABLED=1
    echo "Docker-login plugin enabled"
    ;;
  ecr)
    export ECR_PLUGIN_ENABLED=1
    echo "ECR plugin enabled"
    ;;
  esac
done

if [[ -n "${BUILDKITE_SECRETS_BUCKET:-}" && "${SECRETS_PLUGIN_ENABLED:-}" == "1" ]]; then
  export BUILDKITE_PLUGIN_S3_SECRETS_BUCKET="$BUILDKITE_SECRETS_BUCKET"
  export BUILDKITE_PLUGIN_S3_SECRETS_REGION="$BUILDKITE_SECRETS_BUCKET_REGION"
  export BUILDKITE_PLUGIN_S3_SECRETS_SKIP_SSH_KEY_NOT_FOUND_WARNING="${BUILDKITE_SECRETS_PLUGIN_SKIP_SSH_KEY_NOT_FOUND_WARNING:-false}"

  # shellcheck source=/dev/null
  source /usr/local/buildkite-aws-stack/plugins/secrets/hooks/environment
fi

if [[ "${BUILDKITE_ECR_POLICY:-}" != "none" && "${ECR_PLUGIN_ENABLED:-}" == "1" ]]; then
  export BUILDKITE_PLUGIN_ECR_LOGIN=1
  export BUILDKITE_PLUGIN_ECR_RETRIES=3

  # Allow pipeline-level override, otherwise use CloudFormation parameter
  set_unless_present "BUILDKITE_PLUGIN_ECR_CREDENTIAL_HELPER" "${ECR_CREDENTIAL_HELPER_ENABLED:-false}"

  # map AWS_ECR_LOGIN_REGISTRY_IDS into the plugin list format
  if [[ -n "${AWS_ECR_LOGIN_REGISTRY_IDS:-}" ]]; then
    export BUILDKITE_PLUGIN_ECR_ACCOUNT_IDS_0="${AWS_ECR_LOGIN_REGISTRY_IDS}"
  fi

  # map AWS_ECR_LOGIN into the plugin format
  if [[ -n "${AWS_ECR_LOGIN:-}" ]]; then
    export BUILDKITE_PLUGIN_ECR_LOGIN="${AWS_ECR_LOGIN}"
  fi

  # shellcheck source=/dev/null
  source /usr/local/buildkite-aws-stack/plugins/ecr/hooks/environment
fi

# Only configure BUILDKITE_ARTIFACT_UPLOAD_DESTINATION if BUILDKITE_ARTIFACT_UPLOAD_DESTINATION is unset,
# BUILDKITE_ARTIFACTS_CONFIGURE_DEFAULT_DESTINATION is "true", and BUILDKITE_ARTIFACTS_BUCKET is configured
# with a bucket name. Log warnings when the variables are configured in unlikely combinations.
if [[ -n "$BUILDKITE_ARTIFACTS_BUCKET" ]]; then
  echo "~~~ Checking artifacts bucket configuration"
  case "${BUILDKITE_ARTIFACTS_CONFIGURE_DEFAULT_DESTINATION:-false}" in
  true)
    if [[ -z "${BUILDKITE_ARTIFACT_UPLOAD_DESTINATION+x}" ]]; then
      # Use the Buildkite-recommended destination: https://buildkite.com/docs/agent/cli/reference/artifact#using-your-private-aws-s3-bucket
      export BUILDKITE_ARTIFACT_UPLOAD_DESTINATION="s3://${BUILDKITE_ARTIFACTS_BUCKET}/${BUILDKITE_PIPELINE_ID}/${BUILDKITE_BUILD_ID}/${BUILDKITE_JOB_ID}"
    else
      echo "^^^ +++ :warning: BUILDKITE_ARTIFACT_UPLOAD_DESTINATION is already set to '$BUILDKITE_ARTIFACT_UPLOAD_DESTINATION'. Skipping default destination configuration."
    fi
    ;;

  false)
    if [[ -z "${BUILDKITE_ARTIFACT_UPLOAD_DESTINATION+x}" ]]; then
      echo "^^^ +++ :warning: An artifacts bucket is configured while BUILDKITE_ARTIFACT_UPLOAD_DESTINATION is unset and BUILDKITE_ARTIFACTS_CONFIGURE_DEFAULT_DESTINATION is false."
      echo "Skipping default artifact upload destination configuration. Artifacts will continue to upload to Buildkite's bucket unless pipeline, step-level, or agent-level configuration is changed."
      echo "If this is intentional, set BUILDKITE_ARTIFACTS_CONFIGURE_DEFAULT_DESTINATION to 'false-and-suppress-warning' to suppress this warning."
    else
      echo "Preserving explicitly configured destination '$BUILDKITE_ARTIFACT_UPLOAD_DESTINATION'."
    fi
    ;;

  false-and-suppress-warning)
    if [[ -z "${BUILDKITE_ARTIFACT_UPLOAD_DESTINATION+x}" ]]; then
      echo "Skipping default artifact upload destination configuration."
    else
      echo "Preserving explicitly configured destination '$BUILDKITE_ARTIFACT_UPLOAD_DESTINATION'."
    fi
    ;;

  esac
fi
