#!/bin/bash
set -euo pipefail

MAX_ATTEMPTS=3

backoff() {
  local attempt="$1" attempts="${2:-$MAX_ATTEMPTS}"
  if [[ "$attempt" -lt "$attempts" ]]; then
    sleep $((attempt * 2))
  fi
}

# $2 caps the attempts, defaulting to MAX_ATTEMPTS.
metadata() {
  local attempt token value attempts="${2:-$MAX_ATTEMPTS}"
  for attempt in $(seq "$attempts"); do
    if token=$(curl -sf -X PUT --max-time 5 \
      -H "X-aws-ec2-metadata-token-ttl-seconds: 30" \
      http://169.254.169.254/latest/api/token); then
      if value=$(curl -sf --max-time 5 \
        -H "X-aws-ec2-metadata-token: $token" \
        "http://169.254.169.254/latest/meta-data/$1"); then
        echo "$value"
        return 0
      fi
    fi

    echo "Attempt ${attempt} of ${attempts} to read metadata '$1' failed." >&2
    backoff "$attempt" "$attempts"
  done

  return 1
}

# Exits non-zero on a real failure so that callers do not start the agent on an instance
# whose lifecycle action is still pending: the hook would time out and ABANDON would
# terminate it mid-job. Being abandoned before taking work is the better outcome.
if ! instance_id=$(metadata instance-id) || ! region=$(metadata placement/region); then
  echo "ERROR: Could not read instance metadata, cannot complete lifecycle action."
  exit 1
fi

# The launch template enables instance metadata tags and Auto Scaling tags its instances with
# aws:autoscaling:groupName. Preferred over describe-auto-scaling-instances because it keeps an
# Auto Scaling API call off the path to the agent starting, and spares the account's rate limit
# during a scale-out burst, which is when complete-lifecycle-action needs that same budget.
#
# Tried once rather than retried: whether IMDS serves reserved aws: tags under tags/instance is
# not documented, and a path it does not serve fails identically on every attempt. Falling
# through immediately costs less than the backoff would.
if ! asg_name=$(metadata "tags/instance/aws:autoscaling:groupName" 1) || [[ -z "$asg_name" ]]; then
  # Reached when the tag is unavailable, so the group name is resolved from the API instead. On
  # the InService path a failure here is fatal twice over: the ERR trap in the caller fails the
  # cfn-signal, which fails stack creation for the initial MinSize instances.
  echo "Could not read the Auto Scaling group name from instance metadata tags, falling back to the Auto Scaling API..."

  asg_name=""
  for attempt in $(seq "$MAX_ATTEMPTS"); do
    if asg_name=$(aws autoscaling describe-auto-scaling-instances \
      --region "$region" \
      --instance-ids "$instance_id" \
      --query 'AutoScalingInstances[0].AutoScalingGroupName' \
      --output text 2>&1); then
      break
    fi

    echo "Attempt ${attempt} of ${MAX_ATTEMPTS} to resolve Auto Scaling group name failed: ${asg_name}"
    asg_name=""
    backoff "$attempt"
  done

  # --output text renders a missing value as the literal string None, not as empty output.
  if [[ -z "$asg_name" || "$asg_name" == "None" ]]; then
    echo "ERROR: Could not resolve Auto Scaling group name, cannot complete lifecycle action."
    exit 1
  fi
fi

echo "Completing warm pool lifecycle action for ${instance_id} in ${asg_name}..."
for attempt in $(seq "$MAX_ATTEMPTS"); do
  if output=$(aws autoscaling complete-lifecycle-action \
    --region "$region" \
    --auto-scaling-group-name "$asg_name" \
    --lifecycle-hook-name WarmPoolBootstrap \
    --lifecycle-action-result CONTINUE \
    --instance-id "$instance_id" 2>&1); then
    echo "Completed warm pool lifecycle action."
    exit 0
  fi

  # Expected on the initial MinSize instances, which launch before the hook exists. This
  # script only runs on a warm pool stack, so there is no pending action to find on those.
  # Not a failure, so do not retry it.
  if [[ "$output" == *"No active Lifecycle Action found"* ]]; then
    echo "No pending lifecycle action, nothing to complete."
    exit 0
  fi

  echo "Attempt ${attempt} of ${MAX_ATTEMPTS} to complete lifecycle action failed: ${output}"
  backoff "$attempt"
done

echo "ERROR: Failed to complete warm pool lifecycle action after ${MAX_ATTEMPTS} attempts."
exit 1
